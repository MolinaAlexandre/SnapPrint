# URL du backend FastAPI (utilisée par le proxy Next.js pour les requêtes courtes).
BACKEND_URL=http://localhost:8000

# URL du backend appelée EN DIRECT par le navigateur pour les requêtes longues
# (génération ~1-2 min) afin d'éviter le timeout du proxy Next (socket hang up).
# Le backend autorise CORS depuis http://localhost:3000.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
