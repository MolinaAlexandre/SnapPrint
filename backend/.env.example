# ==========================================
# SnapPrint / VoiceCAD - Backend config
# Copier ce fichier vers .env et remplir les valeurs.
# ==========================================

# --- Muse (Meta) : Voice Transcribe + Spark ---
MUSE_API_KEY=your_muse_api_key_here
MUSE_API_BASE=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0

# --- Baseten (fallback Muse Spark Open) ---
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_API_BASE=https://inference.baseten.co/v1

# --- SAM 3.1 (segmentation) ---
# Laisser vide pour utiliser le mode mock local.
SAM_API_KEY=
SAM_API_BASE=

# --- Pipeline ---
# Mode mock pour la vision (true = masques simulés sans appel externe)
USE_MOCK_VISION=true
# Chemin de l'exécutable OpenSCAD
OPENSCAD_BIN=openscad
# Répertoire de sortie des STL/SCAD
OUTPUT_DIR=outputs
